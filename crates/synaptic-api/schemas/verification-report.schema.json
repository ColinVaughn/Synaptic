{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synaptic.dev/schemas/verification-report-v1.json",
  "title": "Synaptic API verification report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "verified", "gates"],
  "properties": {
    "version": {"const": 1}, "verified": {"type": "boolean"},
    "gates": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["gate", "outcome", "detail", "duration_ms"],
      "properties": {"gate": {"type": "string"}, "outcome": {"enum": ["passed", "failed", "inconclusive"]}, "detail": {"type": "string"}, "duration_ms": {"type": "integer", "minimum": 0}}
    }}
  }
}
