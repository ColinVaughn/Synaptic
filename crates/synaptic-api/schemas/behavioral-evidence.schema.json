{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synaptic.dev/schemas/behavioral-evidence-v1.json",
  "title": "Synaptic Behavioral Evidence Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "origin",
    "environment",
    "window_start_unix_nano",
    "window_end_unix_nano",
    "complete_window",
    "observations",
    "review_candidates"
  ],
  "properties": {
    "version": { "const": 1 },
    "origin": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "minLength": 1, "maxLength": 512 },
    "window_start_unix_nano": { "type": "integer", "minimum": 0 },
    "window_end_unix_nano": { "type": "integer", "minimum": 0 },
    "complete_window": { "type": "boolean" },
    "observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/observation" }
    },
    "review_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "protocol",
        "method",
        "outcome",
        "occurrences",
        "evidence_digest"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^behavioral_observation_" },
        "kind": { "enum": ["http", "rpc", "message"] },
        "protocol": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^/" },
        "service": { "type": "string", "minLength": 1 },
        "operation": { "type": "string", "minLength": 1 },
        "outcome": {
          "enum": [
            "success",
            "client_error",
            "server_error",
            "timeout",
            "contract_violation",
            "unavailable"
          ]
        },
        "occurrences": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "evidence_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "summary", "confidence"],
      "properties": {
        "observation_id": { "type": "string", "pattern": "^behavioral_observation_" },
        "summary": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
