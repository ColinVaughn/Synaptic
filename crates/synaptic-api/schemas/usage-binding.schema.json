{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synaptic.dev/schemas/usage-binding-v1.json",
  "title": "Synaptic API usage binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["vendor", "operation_node_id", "caller_node_id", "source_file", "basis", "confidence"],
  "properties": {
    "vendor": {"type": "string", "minLength": 1},
    "operation_node_id": {"type": "string", "minLength": 1},
    "caller_node_id": {"type": "string", "minLength": 1},
    "source_file": {"type": "string", "minLength": 1},
    "source_location": {"type": "string"},
    "sdk_package": {"type": "string"},
    "sdk_member": {"type": "string"},
    "sdk_version": {"type": "string"},
    "api_version": {"type": "string"},
    "basis": {"enum": ["absolute_url_host", "sdk_symbol", "generated_client", "configured_host", "unknown"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
