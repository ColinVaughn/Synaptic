{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synaptic.dev/schemas/api-coverage-report-v1.json",
  "title": "Synaptic API Coverage Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "complete",
    "raw_evidence",
    "dependency_inventory",
    "development_dependencies",
    "waivers_applied",
    "evidence_complete",
    "evidence_windows",
    "behavioral_review_candidates",
    "counts",
    "observations",
    "gaps"
  ],
  "properties": {
    "version": { "const": 1 },
    "complete": { "type": "boolean" },
    "raw_evidence": { "type": "integer", "minimum": 0 },
    "dependency_inventory": { "type": "integer", "minimum": 0 },
    "development_dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "waivers_applied": { "type": "integer", "minimum": 0 },
    "evidence_complete": { "type": "boolean" },
    "evidence_windows": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceWindow" }
    },
    "behavioral_review_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/behavioralCandidate" }
    },
    "counts": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/state" },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "observations": {
      "type": "array",
      "items": { "$ref": "#/$defs/observation" }
    },
    "gaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/gap" }
    }
  },
  "$defs": {
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "source_file", "scope"],
      "properties": {
        "package": { "type": "string", "minLength": 1 },
        "source_file": { "type": "string", "minLength": 1 },
        "scope": { "enum": ["runtime", "development", "optional"] },
        "declared_requirement": { "type": "string" },
        "resolved_version": { "type": "string", "minLength": 1 },
        "purl": { "type": "string", "pattern": "^pkg:" }
      }
    },
    "state": {
      "enum": [
        "observed",
        "identified",
        "modeled",
        "monitored",
        "bound",
        "repair_eligible"
      ]
    },
    "kind": {
      "enum": [
        "http",
        "sdk",
        "rpc",
        "message",
        "web_socket",
        "command",
        "native",
        "service",
        "package_dependency",
        "dynamic_dispatch"
      ]
    },
    "gapKind": {
      "enum": [
        "provider_identity",
        "ambiguous_owner",
        "contract_model",
        "change_source",
        "operation_binding",
        "resolved_version",
        "dynamic_target",
        "usage_classification"
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "id",
        "kind",
        "identity",
        "state",
        "source_file",
        "evidence_digest",
        "gaps",
        "waived"
      ],
      "properties": {
        "version": { "const": 1 },
        "id": { "type": "string", "pattern": "^external_surface_" },
        "kind": { "$ref": "#/$defs/kind" },
        "identity": { "type": "string", "minLength": 1 },
        "state": { "$ref": "#/$defs/state" },
        "provider": { "type": "string", "minLength": 1 },
        "protocol": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "package": { "type": "string", "minLength": 1 },
        "member": { "type": "string", "minLength": 1 },
        "operation_id": { "type": "string", "minLength": 1 },
        "resolved_version": { "type": "string", "minLength": 1 },
        "source_file": { "type": "string" },
        "source_location": { "type": "string", "minLength": 1 },
        "source_node_id": { "type": "string", "minLength": 1 },
        "evidence_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "gaps": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/gapKind" }
        },
        "waived": { "type": "boolean" },
        "waiver_reason": { "type": "string", "minLength": 1, "maxLength": 512 }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "kind"],
      "properties": {
        "observation_id": { "type": "string", "pattern": "^external_surface_" },
        "kind": { "$ref": "#/$defs/gapKind" }
      }
    },
    "evidenceWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_kind", "environment", "complete", "origin"],
      "properties": {
        "evidence_kind": { "enum": ["static_extraction", "runtime_trace", "sbom_inventory"] },
        "environment": { "type": "string", "minLength": 1 },
        "start_unix_nano": { "type": "integer", "minimum": 0 },
        "end_unix_nano": { "type": "integer", "minimum": 0 },
        "complete": { "type": "boolean" },
        "origin": { "type": "string", "minLength": 1 }
      }
    },
    "behavioralCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observation_id", "summary", "confidence"],
      "properties": {
        "observation_id": { "type": "string", "pattern": "^behavioral_observation_" },
        "summary": { "type": "string", "minLength": 1 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
